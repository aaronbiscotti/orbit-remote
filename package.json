{
  "name": "orbit-remote",
  "productName": "Orbit",
  "version": "1.0.0",
  "description": "High-performance Remote OS Takeover for Windows and macOS",
  "main": "electron/main.js",
  "author": "Aaron Tang",
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist:win": "electron-builder --win nsis zip --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --publish never",
    "build:video:mac": "bash scripts/build-video-mac.sh",
    "test:video": "node --test tests/video-session.test.js tests/video-renderer.test.js tests/native-video-session.test.js",
    "dist:mac:gpu": "npm run build:video:mac && electron-builder --mac zip --arm64",
    "test": "node --test \"tests/*.test.js\""
  },
  "build": {
    "appId": "local.orbit.remote",
    "productName": "Orbit",
    "asar": false,
    "electronLanguages": [
      "en"
    ],
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "mac": {
      "icon": "electron/assets/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "extraResources": [
        {
          "from": "dist/video-engine",
          "to": "video-engine",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "dist/Orbit-Host",
          "to": "engine",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "scripts",
          "to": "scripts",
          "filter": [
            "*.ps1"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orbit",
      "installerIcon": "electron/assets/icon.ico",
      "uninstallerIcon": "electron/assets/icon.ico",
      "installerHeaderIcon": "electron/assets/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  }
}
