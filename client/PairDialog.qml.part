    NavigableDialog {
        id: pairDialog
        closePolicy: Popup.CloseOnEscape
        property string pin: "0000"
        title: qsTr("Pair with your PC")
        standardButtons: Dialog.Cancel
        ColumnLayout {
            spacing: 20
            Label { text: qsTr("Enter this code in Orbit Host on your PC."); color: "#A5ADC1"; Layout.fillWidth: true; wrapMode: Text.Wrap }
            Rectangle {
                Layout.fillWidth: true; Layout.preferredHeight: 110; radius: 20; color: "#121620"
                Label { anchors.centerIn: parent; text: pairDialog.pin; font.pixelSize: 48; font.letterSpacing: 12; font.family: Qt.platform.os === "osx" ? "Menlo" : "Consolas"; color: "#BAC8FF" }
            }
            RowLayout {
                Layout.alignment: Qt.AlignHCenter
                BusyIndicator { Layout.preferredWidth: 28; Layout.preferredHeight: 28; running: pairDialog.visible }
                Label { text: qsTr("Waiting for approval on your PC…"); color: "#929CB4" }
            }
        }
    }
