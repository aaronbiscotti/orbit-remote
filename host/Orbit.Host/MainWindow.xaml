<Window x:Class="Orbit.Host.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Orbit Host" Width="860" Height="880" MinWidth="720" MinHeight="650" Background="#101218" WindowStartupLocation="CenterScreen" Foreground="#EEF1FA">
  <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,24,32,28">
      <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="48" Height="48" CornerRadius="24" Background="#B7C5FF" Margin="0,0,15,0"><TextBlock Text="◌" FontSize="37" Foreground="#151927" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel Grid.Column="1"><TextBlock Text="Orbit" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Your PC, wherever you are" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
        <Border Grid.Column="2" CornerRadius="16" Background="#222B3B" Padding="14,9" VerticalAlignment="Center"><TextBlock Text="WINDOWS HOST" FontSize="10" Foreground="#B7C5FF"/></Border>
      </Grid>
      <Border Background="#1B1F2A" CornerRadius="26" Padding="24" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock x:Name="ComputerName" FontSize="25" FontWeight="SemiBold"/>
          <TextBlock x:Name="HostStatus" Text="Checking your host…" Foreground="{StaticResource Muted}" Margin="0,8,0,14" FontSize="14"/>
          <TextBlock Text="Connect from your Mac using this address" FontSize="12" Foreground="{StaticResource Muted}"/>
          <Grid Margin="0,10,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="Address" IsReadOnly="True" BorderThickness="0" Background="#121620" FontFamily="Consolas"/>
            <Button Grid.Column="1" Content="Copy" Margin="12,0,0,0" Click="CopyAddress"/>
          </Grid>
          <TextBlock x:Name="NetworkHint" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
          <WrapPanel>
            <Button x:Name="StartButton" Content="Start host" Background="#B7C5FF" Foreground="#151927" Click="StartHost" Margin="0,0,10,8"/>
            <Button Content="Sunshine settings" Click="OpenSettings" Margin="0,0,10,8"/>
            <Button Content="Tailscale setup" Click="OpenTailscale" Margin="0,0,0,8"/>
          </WrapPanel>
          <CheckBox x:Name="KeepAwake" Content="Keep this PC awake while Orbit Host is open" Margin="0,8,0,0" Checked="AwakeChanged" Unchecked="AwakeChanged"/>
        </StackPanel>
      </Border>
      <Border Background="#1B1F2A" CornerRadius="26" Padding="24" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Authorize your Mac" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="LoginHint" Text="Create your admin login here on first launch. Your password stays in memory only; Sunshine stores its password hash locally." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,16"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="Admin username" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="Username"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Admin password" FontSize="11" Margin="0,0,0,6"/><PasswordBox x:Name="Password"/></StackPanel>
            <Button x:Name="LoginButton" Grid.Column="2" Content="Create login" VerticalAlignment="Bottom" Click="Unlock"/>
          </Grid>
          <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="Pending device" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="Pending" Height="40" DisplayMemberPath="Name" IsEnabled="False"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Code shown on Mac" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="PairCode" MaxLength="4" IsEnabled="False" FontFamily="Consolas"/></StackPanel>
            <Button x:Name="PairButton" Grid.Column="2" Content="Pair" VerticalAlignment="Bottom" IsEnabled="False" Click="Approve"/>
          </Grid>
          <TextBlock x:Name="PairStatus" Text="Add this PC in the Orbit client, then click its card to see your pairing code." TextWrapping="Wrap" FontSize="12" Foreground="#A5B4D8" Margin="0,12,0,0"/>
          <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="Clients" DisplayMemberPath="Name" Height="38" IsEnabled="False"/>
            <Button x:Name="RevokeButton" Grid.Column="1" Content="Revoke device" IsEnabled="False" Margin="12,0,0,0" Click="Revoke"/>
          </Grid>
        </StackPanel>
      </Border>
      <Border Background="#1B1F2A" CornerRadius="26" Padding="24">
        <StackPanel>
          <TextBlock Text="Displays &amp; streaming" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="Displays" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,14"/>
          <TextBlock Text="Client default: 1080p · requested 120 fps · hardware decoding" Foreground="#B7C5FF" FontSize="12"/>
          <TextBlock Text="Switch displays: Control + Option + Shift + F1…F12 on your Mac (Fn may be needed). One display streams at a time in this version." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
      <TextBlock x:Name="StatusLine" Text="Local companion · Powered by Sunshine and Moonlight" Foreground="#75819A" FontSize="11" TextWrapping="Wrap" Margin="2,18,2,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>
