<Window x:Class="Orbit.Host.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Orbit Host" Width="760" Height="820" MinWidth="680" MinHeight="640" Background="#101218" WindowStartupLocation="CenterScreen" Foreground="#EEF1FA">
  <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,24,32,24">
      <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="44" Height="44" CornerRadius="22" Background="#B7C5FF" Margin="0,0,14,0"><TextBlock Text="◌" FontSize="34" Foreground="#151927" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel Grid.Column="1"><TextBlock Text="Orbit" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Connect your Mac" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
        <Border Grid.Column="2" CornerRadius="16" Background="#1B1F2A" Padding="14,9" VerticalAlignment="Center"><TextBlock x:Name="HostStatus" Text="Checking…" FontSize="12" Foreground="#A6D7BD"/></Border>
      </Grid>
      <Border Background="#1B1F2A" CornerRadius="24" Padding="22" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="ComputerName" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="NetworkHint" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
        <Button x:Name="StartButton" Grid.Column="1" Content="Start PC sharing" Click="StartHost" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Grid></Border>
      <UniformGrid Columns="3" Margin="0,0,0,20">
        <Border x:Name="StepOne" CornerRadius="15" Padding="12" Margin="0,0,6,0"><TextBlock x:Name="StepOneLabel" Text="1  Protect PC" HorizontalAlignment="Center" FontSize="13"/></Border>
        <Border x:Name="StepTwo" CornerRadius="15" Padding="12" Margin="3,0,3,0"><TextBlock x:Name="StepTwoLabel" Text="2  Allow access" HorizontalAlignment="Center" FontSize="13"/></Border>
        <Border x:Name="StepThree" CornerRadius="15" Padding="12" Margin="6,0,0,0"><TextBlock x:Name="StepThreeLabel" Text="3  Connect Mac" HorizontalAlignment="Center" FontSize="13"/></Border>
      </UniformGrid>
      <Border Background="#1B1F2A" CornerRadius="26" Padding="28"><StackPanel>
        <StackPanel x:Name="LoginPanel">
          <TextBlock x:Name="LoginTitle" Text="Protect your PC" FontSize="26" FontWeight="SemiBold"/>
          <TextBlock x:Name="LoginHint" Text="Choose a password to approve your Mac." Foreground="{StaticResource Muted}" Margin="0,8,0,24"/>
          <TextBlock Text="Username" FontSize="12" Margin="0,0,0,7"/><TextBox x:Name="Username" Text="orbit" TextChanged="CredentialsChanged" Margin="0,0,0,16"/>
          <TextBlock Text="Password" FontSize="12" Margin="0,0,0,7"/><PasswordBox x:Name="Password" PasswordChanged="CredentialsChanged"/>
          <TextBlock x:Name="PasswordHint" Text="12 characters or more" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,20"/>
          <Button x:Name="LoginButton" Content="Save &amp; continue →" Background="#B7C5FF" Foreground="#151927" HorizontalAlignment="Right" Click="Unlock"/>
        </StackPanel>
        <StackPanel x:Name="PermissionPanel" Visibility="Collapsed">
          <TextBlock Text="Allow your Mac to connect" FontSize="26" FontWeight="SemiBold"/>
          <TextBlock Text="Windows will ask for administrator approval." Foreground="{StaticResource Muted}" Margin="0,8,0,28"/>
          <Border Background="#121620" CornerRadius="18" Padding="20" Margin="0,0,0,24"><TextBlock x:Name="PermissionHint" Text="Checking connection permission…" FontSize="14" TextWrapping="Wrap"/></Border>
          <Button x:Name="EnableButton" Content="Allow connections →" Background="#B7C5FF" Foreground="#151927" HorizontalAlignment="Right" Click="EnableConnections"/>
        </StackPanel>
        <StackPanel x:Name="ConnectPanel" Visibility="Collapsed">
          <TextBlock x:Name="ConnectTitle" Text="Now, on your Mac" FontSize="26" FontWeight="SemiBold"/>
          <StackPanel x:Name="MacInstructions">
            <Grid Margin="0,20,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="32" Height="32" CornerRadius="16" Background="#2B3348" Margin="0,0,12,0"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <StackPanel Grid.Column="1"><TextBlock Text="Open Orbit on your Mac" FontSize="15"/><Button Content="Get the Mac app ↗" HorizontalAlignment="Left" Padding="0,8" Background="Transparent" Foreground="#B7C5FF" Click="GetMacApp"/></StackPanel>
            </Grid>
            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="32" Height="32" CornerRadius="16" Background="#2B3348" Margin="0,0,12,0"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock Grid.Column="1" Text="Click Add PC. Enter this address." FontSize="15" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="44,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="Address" IsReadOnly="True" FontFamily="Consolas" FontSize="21"/>
              <Button x:Name="CopyButton" Grid.Column="1" Content="Copy address" Margin="10,0,0,0" Click="CopyAddress"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="32" Height="32" CornerRadius="16" Background="#2B3348" Margin="0,0,12,0"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock Grid.Column="1" Text="Click your PC. A code appears on your Mac." FontSize="15" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="WaitingHint" Text="Waiting for your Mac…" Foreground="{StaticResource Muted}" Margin="44,18,0,0"/>
          </StackPanel>
          <StackPanel x:Name="PairPanel" Visibility="Collapsed" Margin="0,24,0,0">
            <TextBlock x:Name="PairDeviceHint" Text="Enter the code shown on your Mac" FontSize="15" Margin="0,0,0,12"/>
            <ComboBox x:Name="Pending" Height="40" DisplayMemberPath="Name" Margin="0,0,0,12"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="PairCode" MaxLength="4" FontFamily="Consolas" FontSize="32" HorizontalContentAlignment="Center" TextChanged="PinChanged" PreviewTextInput="PinInput"/>
              <Button x:Name="PairButton" Grid.Column="1" Content="Pair Mac →" Background="#B7C5FF" Foreground="#151927" Margin="12,0,0,0" IsEnabled="False" Click="Approve"/>
            </Grid>
          </StackPanel>
          <StackPanel x:Name="SuccessPanel" Visibility="Collapsed" Margin="0,24,0,0">
            <Border Width="70" Height="70" CornerRadius="35" Background="#253A34" HorizontalAlignment="Left"><TextBlock Text="✓" Foreground="#A6D7BD" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Text="On your Mac, select your PC → Desktop." FontSize="17" Margin="0,20,0,18"/>
            <Button Content="Connect another Mac" HorizontalAlignment="Left" Click="ConnectAnother"/>
          </StackPanel>
        </StackPanel>
        <TextBlock x:Name="StatusLine" Foreground="#BAC8FF" FontSize="13" TextWrapping="Wrap" Margin="0,18,0,0" Visibility="Collapsed"/>
      </StackPanel></Border>
      <CheckBox x:Name="KeepAwake" Content="Keep PC awake while Orbit is open" Margin="8,20,0,18" Checked="AwakeChanged" Unchecked="AwakeChanged"/>
      <Expander Header="More options" Foreground="{StaticResource Muted}"><StackPanel Margin="8,16,8,0">
        <WrapPanel><Button Content="Host settings ↗" Click="OpenSettings" Margin="0,0,8,10"/><Button Content="Tailscale ↗" Click="OpenTailscale" Margin="0,0,8,10"/><Button Content="Check access" Click="CheckAccess" Margin="0,0,0,10"/></WrapPanel>
        <TextBlock Text="Paired devices" FontSize="12" Margin="0,8,0,8"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="Clients" DisplayMemberPath="Name" Height="40" IsEnabled="False"/><Button x:Name="RevokeButton" Grid.Column="1" Content="Remove access" IsEnabled="False" Margin="12,0,0,0" Click="Revoke"/></Grid>
        <TextBlock x:Name="Displays" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,18,0,8"/>
        <TextBlock Text="Switch monitor: Control + Option + Shift + F1…F12" Foreground="{StaticResource Muted}" FontSize="12"/>
        <TextBlock Text="One monitor at a time · 120 fps requested" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
      </StackPanel></Expander>
    </StackPanel>
  </ScrollViewer>
</Window>
